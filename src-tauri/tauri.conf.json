{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-app",
  "version": "0.1.0",
  "identifier": "com.khung.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chuẩn bị máy",
        "width": 1080,
        "height": 760
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../scripts/faster_whisper.py": "scripts/faster_whisper.py",
      "douyin/fetch.py": "douyin/fetch.py",
      "douyin/__init__.py": "douyin/__init__.py",
      "douyin/dtk/__init__.py": "douyin/dtk/__init__.py",
      "douyin/dtk/signing/__init__.py": "douyin/dtk/signing/__init__.py",
      "douyin/dtk/signing/native/abogus.py": "douyin/dtk/signing/native/abogus.py",
      "douyin/dtk/signing/native/sm3.py": "douyin/dtk/signing/native/sm3.py",
      "douyin/dtk/signing/native/websign.py": "douyin/dtk/signing/native/websign.py",
      "douyin/dtk/signing/native/__init__.py": "douyin/dtk/signing/native/__init__.py"
    }
  }
}
